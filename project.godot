config_version=5

[application]

config/name="aitg"
run/main_scene="uid://cin6024e2i0aa"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"
run/vsync/vsync_mode=1

[display]

window/size/viewport_width=650
window/size/viewport_height=650
window/energy_saving/keep_screen_on=false
window/stretch/mode="canvas_items"
display_server/driver.linuxbsd="wayland"

[dotnet]

project/assembly_name="AntiIdle"

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true

